{
  "registry_name": "dummyjson_recommendation_feature_registry",
  "registry_version": "v1",
  "description": "Custom lightweight feature registry for DummyJSON recommendation pipeline.",
  "created_for": "RecoMart recommendation system assignment",
  "feature_views": [
    {
      "name": "dummyjson_user_features",
      "version": "v1",
      "entity": "user_id",
      "source_path": "data/features/source=dummyjson/user_features.parquet",
      "source_type": "parquet",
      "created_by": "sql/dummyjson_features.sql",
      "description": "User-level cart and interaction aggregation features.",
      "features": [
        "cart_count",
        "total_cart_value",
        "total_discounted_cart_value",
        "total_products_in_carts",
        "total_quantity_in_carts",
        "avg_cart_value",
        "avg_cart_quantity",
        "user_total_interactions",
        "user_unique_items",
        "user_total_quantity",
        "user_total_revenue",
        "user_avg_quantity_per_interaction",
        "user_avg_line_total"
      ],
      "used_for": [
        "training",
        "batch_inference"
      ]
    },
    {
      "name": "dummyjson_item_features",
      "version": "v1",
      "entity": "item_id",
      "source_path": "data/features/source=dummyjson/item_features.parquet",
      "source_type": "parquet",
      "created_by": "sql/dummyjson_features.sql",
      "description": "Item-level catalog, metadata, and interaction aggregation features.",
      "features": [
        "title",
        "description",
        "category",
        "price",
        "discount_percentage",
        "rating",
        "stock",
        "brand",
        "sku",
        "availability_status",
        "minimum_order_quantity",
        "item_total_interactions",
        "item_distinct_user_count",
        "item_total_quantity",
        "item_total_revenue",
        "item_avg_quantity_per_interaction",
        "item_avg_line_total"
      ],
      "used_for": [
        "training",
        "batch_inference",
        "candidate_filtering"
      ]
    },
    {
      "name": "dummyjson_interaction_features",
      "version": "v1",
      "entity": [
        "user_id",
        "item_id",
        "cart_id"
      ],
      "source_path": "data/features/source=dummyjson/interaction_features.parquet",
      "source_type": "parquet",
      "created_by": "sql/dummyjson_features.sql",
      "description": "Interaction-level model input features derived from cart line items.",
      "features": [
        "event_type",
        "interaction_weight",
        "interaction_price",
        "line_total",
        "line_discounted_total",
        "item_category",
        "item_rating",
        "item_stock",
        "item_brand",
        "has_catalog_metadata"
      ],
      "used_for": [
        "training"
      ]
    }
  ]
}